<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cable_disconnected"
            android:textSize="18sp"
            android:gravity="center"
            android:padding="12dp"
            android:background="#222222"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvSelectedApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_app_selected"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btnOverlayPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_overlay"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_accessibility"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnSelectApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_app"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnStartService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_service"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnStopService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stop_service"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permission_info"
            android:textSize="13sp"
            android:paddingTop="16dp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IMPORTANT: Accessibility Service does NOT guarantee sending real KEYCODE_W/A/S/D events to third-party apps (including GameHub). Android security restrictions prevent reliable key injection. See README."
            android:textSize="12sp"
            android:textColor="#FF5722"
            android:paddingTop="12dp" />

    </LinearLayout>
</ScrollView>
